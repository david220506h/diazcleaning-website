---
interface Props {
  title?: string;
  description?: string;
}
const { 
  title = "Diaz Cleaning LLC | House & Commercial Cleaning Phoenix AZ",
  description = "Professional house, commercial & window cleaning in Phoenix, Glendale & surrounding areas. Trusted, reliable & affordable. Call (480) 479-4507."
} = Astro.props;
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Diaz Cleaning LLC",
  "description": "Professional house, commercial and window cleaning services in Phoenix, Glendale, Scottsdale and surrounding areas of Arizona.",
  "telephone": "+14804794507",
  "email": "diazcleaning.az@gmail.com",
  "url": "https://www.diazcleaning-az.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "9838 N 44th Drive",
    "addressLocality": "Glendale",
    "addressRegion": "AZ",
    "postalCode": "85302",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 33.5386,
    "longitude": -112.1442
  },
  "areaServed": [
    "Phoenix", "Glendale", "Scottsdale", "Tempe", "Mesa",
    "Chandler", "Peoria", "Surprise", "Avondale", "Goodyear",
    "Maricopa County", "Arizona"
  ],
  "openingHours": ["Mo-Fr 08:00-18:00", "Sa 09:00-14:00"],
  "priceRange": "$$",
  "serviceType": [
    "House Cleaning", "Commercial Cleaning", "Window Cleaning",
    "Deep Cleaning", "Office Cleaning", "Industrial Cleaning"
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Cleaning Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "House Cleaning Phoenix AZ" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Commercial Cleaning Phoenix AZ" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Window Cleaning Phoenix AZ" } }
    ]
  }
});
---
<title>{title}</title>
<link rel="canonical" href="https://www.diazcleaning-az.com" />
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<!-- Hreflang -->
<link rel="alternate" hreflang="en" href="https://www.diazcleaning-az.com" />
<link rel="alternate" hreflang="es" href="https://www.diazcleaning-az.com" />
<link rel="alternate" hreflang="x-default" href="https://www.diazcleaning-az.com" />
<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content="https://www.diazcleaning-az.com" />
<meta property="og:locale" content="en_US" />
<meta property="og:locale:alternate" content="es_MX" />
<!-- Schema JSON-LD -->
<script type="application/ld+json" set:html={schema} />
